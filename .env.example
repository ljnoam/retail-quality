# Projet Google Cloud autorisé à lancer des jobs sur les tables publiques.
GOOGLE_CLOUD_PROJECT=
BIGQUERY_LOCATION=US
# Identifiants locaux PostgreSQL de démonstration ; remplacer dans .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail_quality
PGUSER=retail_quality
PGPASSWORD=
# Période C3 fixe issue des diagnostics BigQuery/BCE.
RQ_START_DATE=2024-01-01
RQ_END_DATE=2024-02-01
RQ_RATE_MAX_AGE_DAYS=7
